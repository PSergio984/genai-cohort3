# Template for app/client/.env (copy to .env, fill values, never commit).
# Public web identifiers (ship to every browser), NOT secrets — but scanner-hostile,
# so they ride env. Values: Firebase console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
