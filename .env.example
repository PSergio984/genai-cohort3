# Copy to `.env` and fill in real values. `.env` is git-ignored; this file is safe to commit.
# Key console links:
#   Gemini key → https://aistudio.google.com/apikey
#   Maps key   → https://console.cloud.google.com/apis/credentials?project=valid-meridian-475214-e3
#   Secrets    → https://console.cloud.google.com/security/secret-manager?project=valid-meridian-475214-e3

# Google Cloud project + region for all gcloud commands (see cmd.md).
PROJECT_ID=valid-meridian-475214-e3
RUN_REGION=us-central1

# Cloud Run runtime service account (default compute SA; verified via `gcloud iam service-accounts list`).
RUN_SA=273533786531-compute@developer.gserviceaccount.com

# Gemini API key (AI Studio). Server-side only — Secret Manager volume in prod, never client-exposed.
GEMINI_API_KEY=

# Google Maps/Places API key (Cloud Console, IP-restricted for server use). Same handling as above.
MAPS_API_KEY=

# Dedicated Firestore database for this effort (us-central1, native). Pre-existing coffee-menu (asia-east1) is NOT ours.
FIRESTORE_DB=grounded-journal

# Firebase web config for local runs (served by Express at /firebase-config.js).
# Public identifiers, not secrets — but scanner-hostile, so fill locally only.
# Values: Firebase console → Project settings → Your apps. The server reads
# shell env (no dotenv); export these before `npm start --prefix app`, e.g.:
#   $env:FIREBASE_WEB_API_KEY="..."; $env:FIREBASE_WEB_AUTH_DOMAIN="..."; ...
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_APP_ID=
